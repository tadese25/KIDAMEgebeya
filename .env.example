# KIDAMEgebeya — required environment variables (set these in Vercel project settings)

# Postgres connection string from Neon (https://neon.tech). Required in production.
DATABASE_URL=

# Resend API key for sending verify/password-reset emails (https://resend.com).
# Without it, emails go to the dev outbox (data/outbox) for local development only.
RESEND_API_KEY=

# Sender address used in outgoing emails. Must be a verified domain in Resend,
# otherwise use the default onboarding@resend.dev sandbox sender.
RESEND_FROM="KIDAMEgebeya <onboarding@resend.dev>"

# Secret used to sign auth (JWT) tokens. Use a long random string.
# Example: generate with: openssl rand -hex 32
JWT_SECRET=

# Admin panel password (defaults to 'admin123' if unset — change in production).
ADMIN_PASSWORD=