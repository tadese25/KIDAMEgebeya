# KIDAMEgebeya — local development environment
# Copy DATABASE_URL (and optionally RESEND_API_KEY) from your Neon/Resend dashboards.
# Set the same variables in Vercel project settings for production.

# Postgres connection string from Neon (https://neon.tech)
DATABASE_URL=

# Resend API key (https://resend.com) — blank = emails go to dev outbox instead.
RESEND_API_KEY=
RESEND_FROM="KIDAMEgebeya <onboarding@resend.dev>"

# Secret used to sign auth (JWT) tokens.
JWT_SECRET=

# Admin panel password (defaults to 'admin123' if unset).
ADMIN_PASSWORD=admin123