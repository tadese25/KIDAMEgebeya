# NOVA email — fill these in to send real reset/verify emails (e.g. Gmail).
# Without them, emails go to the dev outbox (data/outbox) and the link is
# shown inline on the page instead.
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-char app password from Google Account security>
#   SMTP_SECURE=false
#   SMTP_FROM="NOVA <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=